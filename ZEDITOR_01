PROGRAM ZEDITOR.        " FIRST PROGRAM SOURCE

*------------------------------Data-----------------------------*
DATA : BEGIN OF LT_TAB OCCURS 0 ,
  MATNR TYPE MATNR,
  ATINN TYPE ATINN,
  ATWRT TYPE ATWRT,
  WERKS TYPE WERKS_D,
  END OF LT_TAB.



FORM DYN1.                      "Starting

  SELECT A~MATNR
               C~WERKS
                B~ATINN
    FROM MARA AS A INNER JOIN AUSP AS B
    ON A~MATNR = B~OBJEK
    INNER JOIN MARC AS C
    ON A~MATNR = C~MATNR
    INTO CORRESPONDING FIELDS OF TABLE  LT_TAB
    WHERE A~MATNR = '000000000030010677'.

    BREAK-POINT .


ENDFORM .                       "Ending
