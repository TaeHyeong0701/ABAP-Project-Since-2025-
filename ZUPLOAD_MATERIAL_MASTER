"=========================
" EXCEL 업로드 처리
"=========================
FORM UPLOAD_EXCEL.
  DATA: LT_RAW TYPE TABLE OF ALSMEX_TABLINE,
        LS_RAW TYPE ALSMEX_TABLINE.

  CALL FUNCTION 'ALSM_EXCEL_TO_INTERNAL_TABLE'
    EXPORTING
      FILENAME    = P_FILE
      I_BEGIN_COL = 1
      I_BEGIN_ROW = 2
      I_END_COL   = 9
      I_END_ROW   = 9999
    TABLES
      INTERN      = LT_RAW.

  LOOP AT LT_RAW INTO LS_RAW.
    CASE LS_RAW-COL.
      WHEN 1. GS_EXCEL-MATNR = LS_RAW-VALUE.
      WHEN 2. GS_EXCEL-MTART = LS_RAW-VALUE.
      WHEN 3. GS_EXCEL-MBRSH = LS_RAW-VALUE.
      WHEN 4. GS_EXCEL-MATKL = LS_RAW-VALUE.
      WHEN 5. GS_EXCEL-MEINS = LS_RAW-VALUE.
      WHEN 6. GS_EXCEL-GEWEI = LS_RAW-VALUE.
      WHEN 7. GS_EXCEL-SPART = LS_RAW-VALUE.
      WHEN 8. GS_EXCEL-XCHPF = LS_RAW-VALUE.
      WHEN 9. GS_EXCEL-BISMT = LS_RAW-VALUE.
      WHEN 10. GS_EXCEL-EXTWG = LS_RAW-VALUE.
      WHEN 11. GS_EXCEL-MFRPN = LS_RAW-VALUE.
      WHEN 12. GS_EXCEL-MTPOS_MARA = LS_RAW-VALUE.
      WHEN 13. GS_EXCEL-VKORG = LS_RAW-VALUE.
      WHEN 14. GS_EXCEL-VTWEG = LS_RAW-VALUE.
      WHEN 15. GS_EXCEL-SKTOF = LS_RAW-VALUE.
      WHEN 16. GS_EXCEL-DWERK = LS_RAW-VALUE.
      WHEN 17. GS_EXCEL-PRODH = LS_RAW-VALUE.
      WHEN 18. GS_EXCEL-KTGRM = LS_RAW-VALUE.
      WHEN 19. GS_EXCEL-MVGR1 = LS_RAW-VALUE.
      WHEN 20. GS_EXCEL-MVGR2 = LS_RAW-VALUE.
      WHEN 21. GS_EXCEL-MVGR3 = LS_RAW-VALUE.
      WHEN 22. GS_EXCEL-MVGR4 = LS_RAW-VALUE.
      WHEN 23. GS_EXCEL-MVGR5 = LS_RAW-VALUE.
      WHEN 24. GS_EXCEL-LADGR = LS_RAW-VALUE.
      WHEN 25. GS_EXCEL-VBAMG = LS_RAW-VALUE.
      WHEN 26. GS_EXCEL-EKGRP = LS_RAW-VALUE.
      WHEN 27. GS_EXCEL-KZKUP = LS_RAW-VALUE.
      WHEN 28. GS_EXCEL-DISMM = LS_RAW-VALUE.
      WHEN 29. GS_EXCEL-DISPO = LS_RAW-VALUE.
      WHEN 30. GS_EXCEL-PERKZ = LS_RAW-VALUE.
      WHEN 31. GS_EXCEL-STRGR = LS_RAW-VALUE.
      WHEN 32. GS_EXCEL-DISLS = LS_RAW-VALUE.
      WHEN 33. GS_EXCEL-BESKZ = LS_RAW-VALUE.
      WHEN 34. GS_EXCEL-DZEIT = LS_RAW-VALUE.
      WHEN 35. GS_EXCEL-MTVFP = LS_RAW-VALUE.
      WHEN 36. GS_EXCEL-BKLAS = LS_RAW-VALUE.
      WHEN 37. GS_EXCEL-BWTTY = LS_RAW-VALUE.
      WHEN 38. GS_EXCEL-MLAST = LS_RAW-VALUE.
      WHEN 39. GS_EXCEL-VPRSV = LS_RAW-VALUE.
      WHEN 40. GS_EXCEL-PEINH = LS_RAW-VALUE.
      WHEN 41. GS_EXCEL-EKALR = LS_RAW-VALUE.
      WHEN 42. GS_EXCEL-LOSGR = LS_RAW-VALUE.
    ENDCASE.
    AT END OF ROW.
      APPEND GS_EXCEL TO GT_EXCEL.
      CLEAR GS_EXCEL.
    ENDAT.
  ENDLOOP.
ENDFORM.

