REPORT yprofileling_material_master_1.

PARAMETERS: p_tab TYPE tabname OBLIGATORY.

" DDIC 필드 정보
DATA: lt_dfies TYPE TABLE OF dfies,
      ls_dfie  TYPE dfies.

" 동적 내부테이블/워크에어리어 레퍼런스
DATA: gr_table TYPE REF TO data.
FIELD-SYMBOLS: <gt>   TYPE ANY TABLE,
               <wa>   TYPE any,
               <comp> TYPE any.

" 필드명 리스트 (순서보존)
DATA: it_fields TYPE STANDARD TABLE OF string WITH NON-UNIQUE KEY table_line.
DATA: lv_field  TYPE string.


" 제어변수
DATA: lv_rows       TYPE i,
      lv_found_cnt  TYPE i VALUE 0,
      lv_total_cols TYPE i.

" 1) 테이블의 필드 메타정보 조회 (DDIF_FIELDINFO_GET)
CLEAR: lt_dfies.
CALL FUNCTION 'DDIF_FIELDINFO_GET'
  EXPORTING
    tabname   = p_tab
    langu     = sy-langu
  TABLES
    dfies_tab = lt_dfies
  EXCEPTIONS
    OTHERS    = 1.
IF sy-subrc <> 0 OR lt_dfies IS INITIAL.
  MESSAGE |테이블 { p_tab }의 필드 정보를 가져오지 못했습니다.| TYPE 'E'.
  EXIT.
ENDIF.

" 필드명만 추출 (대문자 정규화)
LOOP AT lt_dfies INTO ls_dfie.
  " DFIES-FIELDNAME 은 이미 대문자임
  APPEND ls_dfie-fieldname TO it_fields.
ENDLOOP.

lv_total_cols = lines( it_fields ).

" 값 읽기
DATA: lv_where1 TYPE string,
         lv_where2 TYPE string,
         lv_where3 TYPE string,
         lv_where TYPE string,
         lv_where4 TYPE string,
         lv_where5 TYPE string.
DATA: Gt_fields TYPE STANDARD TABLE OF string WITH NON-UNIQUE KEY table_line,
      gs_fields LIKE LINE OF gt_fields.
LOOP AT it_fields INTO DATA(ls_fields).

*CONCATENATE '|' ls_fields 'NE abap_false|' INTO lv_where separated by space.
  IF ls_fields NE 'MANDT'.
    lv_where1 = |{ ls_fields } NE @SPACE AND |.
    lv_where2 = |{ ls_fields } NE '00000000' AND |.
    lv_where3 = |{ ls_fields } NE '0' AND |.
    lv_where4 = |{ ls_fields } NE 0 AND |.
    lv_where5 = |{ ls_fields } IS NOT NULL  |.

    CONCATENATE lv_where1 lv_where2 lv_where3 lv_where4 lv_where5 INTO lv_where.

    " 1. ZMDAT9012에서 데이터 가져오기
    SELECT matnr
      FROM ymdat9999
      WHERE matnr = '000000000010000032'
      INTO TABLE @DATA(lt_zmdat).

    " 2. 동적 테이블과 조인
    IF lt_zmdat IS NOT INITIAL.
      SELECT COUNT(*)
        FROM (p_tab) AS a
*        WHERE (lv_where)
        FOR ALL ENTRIES IN @lt_zmdat
    WHERE matnr = @lt_zmdat-matnr
        AND (lv_where).
*        AND EXISTS ( SELECT matnr
*                      FROM zmdat9012 WHERE matnr = '38409R0006G' ).
      IF sy-subrc = 0.

        MOVE ls_fields TO gS_fields.
        APPEND gs_fields TO gt_fields .
        CLEAR : gs_fields.


      ENDIF.
    ENDIF.

  ENDIF.


ENDLOOP.

LOOP AT GT_FIELDS INTO GS_FIELDS.

  WRITE : /, GS_FIELDS.

ENDLOOP.


*DATA : lt_components TYPE cl_abap_structdescr=>component_table.
