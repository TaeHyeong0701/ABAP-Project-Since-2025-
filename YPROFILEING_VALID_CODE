PROGRAM ZEDITOR.        " FIRST PROGRAM SOURCE

*------------------------------Data-----------------------------*

FORM DYN1.                      "Starting
*--------------------------------------------------------------------*
*  2023.01.01~2025.01.31 까지의 전표/구매오더/판매오더 생성공급업체
*--------------------------------------------------------------------*
DATA : BEGIN OF GS_DOC,
  GJAHR TYPE GJAHR,
  BELNR TYPE BELNR_D,
  BUKRS TYPE BUKRS,
END OF GS_DOC.

 DATA : GT_DOC LIKE TABLE OF GS_DOC.

DATA : BEGIN OF GS_LIFNR,
  LIFNR TYPE LIFNR,
END OF GS_LIFNR.

DATA: GT_LIFNR LIKE TABLE OF GS_LIFNR.

DATA : BEGIN OF GS_KUNNR,
  KUNNR TYPE KUNNR,
END OF GS_KUNNR.
DATA: GT_KUNNR LIKE TABLE OF GS_KUNNR.

" BKPF
SELECT GJAHR BELNR BUKRS
  APPENDING CORRESPONDING FIELDS OF TABLE  GT_DOC
  FROM BKPF AS A
  WHERE BUDAT BETWEEN '20230101' AND '20250131'.

  SORT GT_DOC BY GJAHR BELNR BUKRS.

 " BSEG-LIFNR
  SELECT A~LIFNR
    FROM BSEG AS A
    APPENDING TABLE GT_LIFNR
    FOR ALL ENTRIES IN GT_DOC
    WHERE A~GJAHR = GT_DOC-GJAHR
    AND A~BELNR = GT_DOC-BELNR
    AND A~BUKRS = GT_DOC-BUKRS.

 " BSEG-KUNNR
  SELECT A~KUNNR
    FROM BSEG AS A
    APPENDING TABLE GT_KUNNR
    FOR ALL ENTRIES IN GT_DOC
    WHERE A~GJAHR = GT_DOC-GJAHR
    AND A~BELNR = GT_DOC-BELNR
    AND A~BUKRS = GT_DOC-BUKRS.

" EKKO
SELECT *
  APPENDING CORRESPONDING FIELDS OF TABLE  GT_LIFNR
  FROM EKKO WHERE LIFNR NE SPACE
  AND AEDAT BETWEEN '20230101' AND '20250131'.

" VBAK
SELECT *
  APPENDING CORRESPONDING FIELDS OF TABLE  GT_KUNNR
  FROM VBAK WHERE KUNNR NE SPACE
  AND ERDAT BETWEEN '20230101' AND '20250131'.

  SORT GT_LIFNR BY LIFNR.
  DELETE ADJACENT DUPLICATES FROM GT_LIFNR COMPARING LIFNR.

  SORT GT_KUNNR BY KUNNR.
  DELETE ADJACENT DUPLICATES FROM GT_KUNNR COMPARING KUNNR.

  BREAK-POINT.


ENDFORM .                       "Ending
