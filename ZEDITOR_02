* 자재마스터 Classification 중 실제 2년간 사용 이력이 있는 데이터 추출
PROGRAM ZEDITOR.        " FIRST PROGRAM SOURCE

*------------------------------Data-----------------------------*

FORM DYN1.                      "Starting

  DATA : BEGIN OF LS_TAB1,
    CHANGENR TYPE CDCHANGENR,
    OBJECTCLAS LIKE CDHDR-OBJECTCLAS,
    OBJECTID TYPE CDOBJECTV,
    END OF LS_TAB1.

   DATA : LT_TAB1 LIKE TABLE OF LS_TAB1.

    DATA : BEGIN OF LS_TAB2,
    CHANGENR TYPE CDCHANGENR,
    OBJECTCLAS LIKE CDHDR-OBJECTCLAS,
    OBJECTID TYPE CDOBJECTV,
      TABNAME TYPE TABNAME,
      TABKEY TYPE TABKEY,
      TABKEY1 TYPE TABKEY,
      END OF LS_TAB2.

     DATA : LT_TAB2 LIKE TABLE OF LS_TAB2.

    SELECT A~CHANGENR
                 A~OBJECTCLAS
                 A~OBJECTID
      FROM CDHDR AS A
      INTO CORRESPONDING FIELDS OF TABLE LT_TAB1
      WHERE A~UDATE BETWEEN '20230101' AND '20250101'.

     SORT LT_TAB1 BY OBJECTCLAS OBJECTID CHANGENR.
      DELETE ADJACENT DUPLICATES FROM LT_TAB1 COMPARING OBJECTCLAS OBJECTID CHANGENR.

    SELECT A~CHANGENR
                  A~OBJECTCLAS
                  A~OBJECTID
                  A~TABNAME
                  A~TABKEY
      FROM CDPOS AS A
      INTO CORRESPONDING FIELDS OF TABLE LT_TAB2
      FOR ALL ENTRIES IN LT_TAB1
      WHERE A~TABNAME = 'ABKSSK'
      AND A~CHANGENR = LT_TAB1-CHANGENR
      AND A~OBJECTCLAS = LT_TAB1-OBJECTCLAS
      AND A~OBJECTID = LT_TAB1-OBJECTID.

DATA: lv_str TYPE string VALUE 'ABC12345',
      lv_last4 TYPE string.

LOOP AT LT_TAB2 INTO LS_TAB2.

   LS_TAB2-TABKEY1 = LS_TAB2-TABKEY+30(9).

   MODIFY LT_TAB2 FROM LS_TAB2 TRANSPORTING TABKEY1.

ENDLOOP.

BREAK-POINT.
SORT LT_TAB2 BY TABKEY1.
DELETE ADJACENT DUPLICATES FROM LT_TAB2 COMPARING TABKEY1.

BREAK-POINT.


ENDFORM .                       "Ending
